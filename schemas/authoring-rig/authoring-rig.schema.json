{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://live2d-maker.local/schemas/authoring-rig.v0.json",
  "title": "AuthoringRig",
  "description": "Pre-PSD Authoring Rig Intermediate Representation (IR). Strictly describes 2D artwork geometry, layers, raster assets, and semantics. Contains NO rigging or animation engine constructs.",
  "type": "object",
  "required": [
    "schemaVersion",
    "canvas",
    "sourceImageHash",
    "parts"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "type": "string",
      "enum": ["0.1.0"]
    },
    "canvas": {
      "type": "object",
      "required": ["width", "height"],
      "additionalProperties": false,
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "sourceImageHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "SHA-256 hash of the composite source/PSD image."
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "author": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "parts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Part"
      }
    }
  },
  "$defs": {
    "Part": {
      "type": "object",
      "required": [
        "id",
        "name",
        "z",
        "asset",
        "geometry",
        "semantic",
        "provenance"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "Stable unique identifier that survives layer renames and reconstructions."
        },
        "name": {
          "type": "string",
          "description": "Human-readable layer name in PSD."
        },
        "z": {
          "type": "integer",
          "minimum": 0,
          "description": "Stacking order / z-index. 0 is the bottom-most layer."
        },
        "appearance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["visible", "opacity"],
          "properties": {
            "visible": {"type": "boolean"},
            "opacity": {"type": "integer", "minimum": 0, "maximum": 255}
          }
        },
        "asset": {
          "type": "object",
          "required": ["path", "sha256", "size", "offset"],
          "additionalProperties": false,
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "description": "Relative file path to the raster PNG asset."
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$",
              "description": "SHA-256 hash of the raster asset file."
            },
            "size": {
              "type": "object",
              "required": ["width", "height"],
              "additionalProperties": false,
              "properties": {
                "width": { "type": "integer", "minimum": 1 },
                "height": { "type": "integer", "minimum": 1 }
              }
            },
            "offset": {
              "type": "object",
              "required": ["left", "top"],
              "additionalProperties": false,
              "properties": {
                "left": { "type": "integer" },
                "top": { "type": "integer" }
              }
            }
          }
        },
        "geometry": {
          "type": "object",
          "required": ["bbox"],
          "additionalProperties": false,
          "properties": {
            "bbox": {
              "type": "array",
              "items": { "type": "integer" },
              "minItems": 4,
              "maxItems": 4,
              "description": "[left, top, right, bottom] in canvas pixels."
            },
            "polygon": {
              "type": "array",
              "minItems": 3,
              "items": {
                "type": "array",
                "items": { "type": "number" },
                "minItems": 2,
                "maxItems": 2
              },
              "description": "Polygon boundary points [[x, y], ...]."
            },
            "landmarks": {
              "type": "object",
              "additionalProperties": {
                "type": "array",
                "items": { "type": "number" },
                "minItems": 2,
                "maxItems": 2
              },
              "description": "Named landmark coordinates e.g. iris_center: [x, y]."
            }
          }
        },
        "semantic": {
          "type": "object",
          "required": ["tag", "side", "confidence"],
          "additionalProperties": false,
          "properties": {
            "tag": {
              "type": "string",
              "enum": [
                "BACK_HAIR",
                "FRONT_HAIR",
                "HEADWEAR",
                "FACE",
                "FACE_DETAIL",
                "IRIDES",
                "EYEBROW",
                "EYEWHITE",
                "EYELASH",
                "EYE_CLOSE",
                "EYEWEAR",
                "EARS",
                "EARWEAR",
                "NOSE",
                "MOUTH",
                "MOUTH_OPEN",
                "MOUTH_CLOSE",
                "TOOTH_T",
                "TOOTH_B",
                "TONGUE",
                "NECK",
                "NECKWEAR",
                "TOPWEAR",
                "HANDWEAR",
                "BOTTOMWEAR",
                "LEGWEAR",
                "FOOTWEAR",
                "TAIL",
                "WINGS",
                "OBJECTS",
                "UNKNOWN"
              ]
            },
            "side": {
              "type": "string",
              "enum": ["none", "left", "right"]
            },
            "override": {
              "type": "object",
              "properties": {
                "tag": {
                  "type": "string",
                  "enum": [
                    "BACK_HAIR",
                    "FRONT_HAIR",
                    "HEADWEAR",
                    "FACE",
                    "FACE_DETAIL",
                    "IRIDES",
                    "EYEBROW",
                    "EYEWHITE",
                    "EYELASH",
                    "EYE_CLOSE",
                    "EYEWEAR",
                    "EARS",
                    "EARWEAR",
                    "NOSE",
                    "MOUTH",
                    "MOUTH_OPEN",
                    "MOUTH_CLOSE",
                    "TOOTH_T",
                    "TOOTH_B",
                    "TONGUE",
                    "NECK",
                    "NECKWEAR",
                    "TOPWEAR",
                    "HANDWEAR",
                    "BOTTOMWEAR",
                    "LEGWEAR",
                    "FOOTWEAR",
                    "TAIL",
                    "WINGS",
                    "OBJECTS",
                    "UNKNOWN"
                  ]
                },
                "side": {
                  "type": "string",
                  "enum": [
                    "none",
                    "left",
                    "right"
                  ]
                }
              },
              "required": [
                "tag",
                "side"
              ],
              "additionalProperties": false
            },
            "confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        },
        "provenance": {
          "type": "object",
          "required": ["source", "toolVersion", "timestamp"],
          "additionalProperties": false,
          "properties": {
            "source": {
              "type": "string",
              "enum": ["see-through", "manual", "vision", "imagegen", "psd-import", "external"]
            },
            "description": { "type": "string", "minLength": 1, "maxLength": 16000 },
            "prompt": { "type": "string", "minLength": 1, "maxLength": 16000 },
            "toolVersion": {
              "type": "string"
            },
            "timestamp": {
              "type": "string",
              "format": "date-time"
            },
            "upstreamHash": {
              "type": ["string", "null"],
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        }
      }
    }
  }
}
