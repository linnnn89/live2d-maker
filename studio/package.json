{
  "name": "live2d-authoring-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/generate-protocol.mjs --check && tsc --noEmit && vite build",
    "check": "tsc --noEmit",
    "draft": "node scripts/draft-cli.mjs",
    "protocol:generate": "node scripts/generate-protocol.mjs",
    "test": "node --test tests/viewer-adapter.test.mjs tests/draft-session.test.mjs tests/artwork.test.mjs tests/protocol.test.mjs"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "fast-png": "8.0.0",
    "fflate": "0.8.3",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "json-schema-to-typescript": "16.0.0",
    "typescript": "5.9.3",
    "vite": "8.3.2"
  }
}
